            margin-bottom: 3rem;
        }

        .hero-meta {
            display: flex;
            align-items: center;
            gap: 2rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border-color);
            font-size: 0.85rem;
            color: var(--text-muted);
