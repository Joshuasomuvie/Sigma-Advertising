            line-height: 1.2;
            margin-bottom: 1rem;
        }

        .section-lead {
            font-size: 1.15rem;
            color: var(--text-secondary);
        }

        /* Cards */
        .card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 2rem;
            transition: var(--transition);
            box-shadow: var(--card-shadow);
